# Optional process environment variables; this file is not automatically loaded.
MAILSENTRA_PUBLIC_URL=http://127.0.0.1:8090
MAILSENTRA_HOST=127.0.0.1
PORT=8090
MAILSENTRA_SERVER_SECRET=
MAILSENTRA_INSTALLER_PATH=
MAILSENTRA_RETENTION_DAYS=30
# PayHere account-specific credentials. Keep private; never put them in HTML or JS.
MAILSENTRA_PAYHERE_MODE=sandbox
MAILSENTRA_PAYHERE_MERCHANT_ID=
MAILSENTRA_PAYHERE_MERCHANT_SECRET=
MAILSENTRA_PAYHERE_APP_ID=
MAILSENTRA_PAYHERE_APP_SECRET=
MAILSENTRA_SUPPORT_EMAIL=
# Only after merchant approval, public policies and successful end-to-end testing:
MAILSENTRA_BILLING_LIVE_APPROVED=false
